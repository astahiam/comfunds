# HajiFund Frontend Environment Configuration
# This file contains all environment variables for the frontend service

# ===========================================
# SERVER CONFIGURATION
# ===========================================
HOST=0.0.0.0
PORT=3000
GIN_MODE=release

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
API_BASE_URL=http://backend:8080
BACKEND_URL=http://backend:8080
FRONTEND_URL=http://103.103.20.68

# ===========================================
# CORS CONFIGURATION
# ===========================================
ALLOWED_ORIGINS=http://103.103.20.68,http://localhost:3000,http://localhost:8080
CORS_ORIGINS=http://103.103.20.68,http://localhost:3000,http://localhost:8080
TRUSTED_PROXIES=103.103.20.68,nginx,127.0.0.1

# ===========================================
# COOKIE CONFIGURATION
# ===========================================
COOKIE_DOMAIN=103.103.20.68
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_HTTP_ONLY=true

# ===========================================
# TEMPLATE CONFIGURATION
# ===========================================
TEMPLATE_DIR=./views
STATIC_DIR=./static

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE=/app/logs/frontend.log

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ===========================================
# CACHE CONFIGURATION
# ===========================================
CACHE_ENABLED=true
CACHE_TTL=300s
CACHE_MAX_SIZE=1000

# ===========================================
# SESSION CONFIGURATION
# ===========================================
SESSION_SECRET=your-frontend-session-secret-change-this
SESSION_MAX_AGE=86400
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
