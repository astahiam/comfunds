# HajiFund Frontend Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Server host and port
HOST=0.0.0.0
PORT=3000

# Environment mode
GIN_MODE=release

# ===========================================
# BACKEND CONFIGURATION
# ===========================================
# Backend API URL
API_BASE_URL=http://backend:8080
BACKEND_URL=http://backend:8080
FRONTEND_URL=http://103.103.20.68

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origins for CORS
ALLOWED_ORIGINS=http://103.103.20.68,http://localhost:3000,http://localhost:8080
CORS_ORIGINS=http://103.103.20.68,http://localhost:3000,http://localhost:8080

# Trusted proxies
TRUSTED_PROXIES=103.103.20.68,nginx,127.0.0.1

# ===========================================
# COOKIE CONFIGURATION
# ===========================================
# Cookie settings for VPS
COOKIE_DOMAIN=103.103.20.68
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_HTTP_ONLY=true

# ===========================================
# TEMPLATE CONFIGURATION
# ===========================================
# Template directory
TEMPLATE_DIR=./views
STATIC_DIR=./static

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info
LOG_FILE=/app/logs/frontend.log

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# ===========================================
# CACHE CONFIGURATION
# ===========================================
# Cache settings
CACHE_ENABLED=true
CACHE_TTL=300s
CACHE_MAX_SIZE=1000

# ===========================================
# SESSION CONFIGURATION
# ===========================================
# Session settings
SESSION_SECRET=your-frontend-session-secret-change-this
SESSION_MAX_AGE=86400
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
