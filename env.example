# HajiFund Environment Configuration
# Copy this file to .env and update the values

# ===========================================
# SERVER CONFIGURATION
# ===========================================
# Server host and port
HOST=0.0.0.0
PORT=8080

# Environment mode (development, production)
GIN_MODE=release

# Server URL (for CORS and cookies)
SERVER_URL=http://103.103.20.68
FRONTEND_URL=http://103.103.20.68
BACKEND_URL=http://103.103.20.68:8080

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Main database connection
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=postgres
DB_SSLMODE=disable

# Database connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# ===========================================
# SHARDING CONFIGURATION
# ===========================================
# Number of database shards
SHARD_COUNT=4

# Shard 0 (comfunds00)
SHARD_0_HOST=postgres
SHARD_0_PORT=5432
SHARD_0_USER=postgres
SHARD_0_PASSWORD=postgres123
SHARD_0_DB=comfunds00

# Shard 1 (comfunds01)
SHARD_1_HOST=postgres
SHARD_1_PORT=5432
SHARD_1_USER=postgres
SHARD_1_PASSWORD=postgres123
SHARD_1_DB=comfunds01

# Shard 2 (comfunds02)
SHARD_2_HOST=postgres
SHARD_2_PORT=5432
SHARD_2_USER=postgres
SHARD_2_PASSWORD=postgres123
SHARD_2_DB=comfunds02

# Shard 3 (comfunds03)
SHARD_3_HOST=postgres
SHARD_3_PORT=5432
SHARD_3_USER=postgres
SHARD_3_PASSWORD=postgres123
SHARD_3_DB=comfunds03

# ===========================================
# REDIS CONFIGURATION
# ===========================================
# Redis connection for sessions and caching
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis123
REDIS_DB=0

# Redis connection pool
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=5

# ===========================================
# JWT CONFIGURATION
# ===========================================
# JWT secret key (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345

# JWT token expiration
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Allowed origins for CORS
ALLOWED_ORIGINS=http://103.103.20.68,http://localhost:3000,http://localhost:8080
CORS_ORIGINS=http://103.103.20.68,http://localhost:3000,http://localhost:8080

# Trusted proxies
TRUSTED_PROXIES=103.103.20.68,nginx,127.0.0.1

# ===========================================
# COOKIE CONFIGURATION
# ===========================================
# Cookie settings for VPS
COOKIE_DOMAIN=103.103.20.68
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_HTTP_ONLY=true

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
# Upload directory
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
# Log level (debug, info, warn, error)
LOG_LEVEL=info
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=3
LOG_MAX_AGE=28

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Password requirements
MIN_PASSWORD_LENGTH=6
REQUIRE_UPPERCASE=false
REQUIRE_LOWERCASE=false
REQUIRE_NUMBERS=false
REQUIRE_SPECIAL=false

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
# SMTP settings for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@hajifund.com

# ===========================================
# MONITORING CONFIGURATION
# ===========================================
# Health check settings
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30s

# Metrics collection
METRICS_ENABLED=true
METRICS_PORT=9090
